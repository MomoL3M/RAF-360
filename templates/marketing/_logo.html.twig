{# Logo RAF360 : marque orbitale (rubans marine/bleu + flèche ambre) + wordmark.
   Params : size (px), dark (bool), word (bool), spin (bool). #}
{% set size = size|default(34) %}
{% set dark = dark|default(false) %}
{% set word = word is defined ? word : true %}
{% set spin = spin|default(false) %}
<span style="display:inline-flex;align-items:center;gap:11px;text-decoration:none;">
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 120 120" fill="none" aria-hidden="true" style="display:block;flex-shrink:0;">
        <defs>
            <linearGradient id="rafNavy" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0B1E45"/><stop offset="1" stop-color="#2C6FB0"/></linearGradient>
            <linearGradient id="rafBlue" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#5B94D6"/><stop offset="1" stop-color="#9CC2F0"/></linearGradient>
            <linearGradient id="rafGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F6B743"/><stop offset="1" stop-color="#E08A0E"/></linearGradient>
        </defs>
        <g{% if spin %} class="spin-slow" style="transform-origin:60px 60px;"{% endif %}>
            <path d="M60 16 A44 44 0 0 1 96 78" stroke="url(#rafNavy)" stroke-width="14" stroke-linecap="round" fill="none"/>
            <path d="M60 104 A44 44 0 0 1 24 42" stroke="url(#rafBlue)" stroke-width="14" stroke-linecap="round" fill="none"/>
            <path d="M96 78 A44 44 0 0 1 60 104" stroke="url(#rafNavy)" stroke-width="14" stroke-linecap="round" fill="none" opacity="0.55"/>
            <path d="M24 42 A44 44 0 0 1 60 16" stroke="url(#rafBlue)" stroke-width="14" stroke-linecap="round" fill="none" opacity="0.7"/>
        </g>
        <g transform="translate(60 60) scale(0.085) translate(-256 -256)">
            <path d="M444.52 3.52 20.6 195.63c-37.53 17-31.52 72.71 8.72 81.14L155.62 302l25.23 126.3c8.42 40.24 64.13 46.25 81.14 8.72L454.06 43.06c11.16-24.71-14.83-50.7-39.54-39.54z" fill="url(#rafGold)"/>
        </g>
    </svg>
    {% if word %}
        <span class="mkt-serif" style="font-weight:700;font-size:{{ (size * 0.6)|round }}px;letter-spacing:0.5px;line-height:1;white-space:nowrap;">
            <span style="color:{{ dark ? '#ffffff' : '#0B1E45' }};">RAF</span> <span style="color:#EDA323;">360</span>
        </span>
    {% endif %}
</span>
