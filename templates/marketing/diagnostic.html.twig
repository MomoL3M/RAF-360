{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}Diagnostic gratuit — RAF360{% endblock %}
{% block meta_description %}Lancez votre diagnostic gratuit RAF360 : indiquez votre SIREN et votre secteur, recevez un premier aperçu de votre niveau de préparation. Sans engagement, sans création de compte.{% endblock %}

{% block marketing %}
    {% import 'marketing/_icons.html.twig' as icon %}

    <section class="page-hero">
        <div class="container">
            <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:18px;">Diagnostic gratuit</div>
            <h1 class="display reveal" data-controller="reveal" style="transition-delay:60ms;max-width:820px;margin-bottom:22px;">Où en est votre entreprise ?</h1>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;max-width:620px;">
                Indiquez votre SIREN et votre activité : RAF360 prépare un premier aperçu de votre situation et de vos
                échéances à venir. Gratuit, sans engagement, sans création de compte.
            </p>
        </div>
    </section>

    <section class="section" style="padding-top:16px;">
        <div class="container">
            <div class="showcase-grid" style="display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:start;">
                {# ---------- Formulaire ---------- #}
                <div class="reveal surface" data-controller="reveal">
                    {% for msg in app.flashes('success') %}
                        <div class="form-alert form-alert-ok" role="status">{{ msg }}</div>
                    {% endfor %}
                    {% if errors._global is defined %}
                        <div class="form-alert form-alert-err" role="alert">{{ errors._global }}</div>
                    {% endif %}

                    <form method="post" action="{{ path('diagnostic') }}" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('lead') }}">
                        <div class="hp-field" aria-hidden="true">
                            <label>Ne remplissez pas ce champ <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
                        </div>

                        <div class="form-row">
                            <label class="form-label" for="siren">SIREN de votre entreprise *</label>
                            <input class="form-field" id="siren" name="siren" type="text" inputmode="numeric" value="{{ data.siren }}" placeholder="9 chiffres" required {% if errors.siren is defined %}aria-invalid="true" aria-describedby="err-siren"{% endif %}>
                            {% if errors.siren is defined %}<p class="form-error" id="err-siren">{{ errors.siren }}</p>{% endif %}
                        </div>
                        <div class="form-row">
                            <label class="form-label" for="email">Email (pour recevoir votre aperçu) *</label>
                            <input class="form-field" id="email" name="email" type="email" value="{{ data.email }}" autocomplete="email" required {% if errors.email is defined %}aria-invalid="true" aria-describedby="err-email"{% endif %}>
                            {% if errors.email is defined %}<p class="form-error" id="err-email">{{ errors.email }}</p>{% endif %}
                        </div>
                        <div class="form-grid">
                            <div class="form-row">
                                <label class="form-label" for="siteWeb">Site internet</label>
                                <input class="form-field" id="siteWeb" name="siteWeb" type="text" value="{{ data.siteWeb }}" placeholder="ex. mon-entreprise.fr" autocomplete="url">
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="typeActivite">Type d'activité</label>
                                <input class="form-field" id="typeActivite" name="typeActivite" type="text" value="{{ data.typeActivite }}" placeholder="ex. commerce, BTP, services…">
                            </div>
                        </div>
                        <button type="submit" class="m-btn m-btn-gold">Lancer mon diagnostic {{ icon.arrowRight(18) }}</button>
                        <p style="color:var(--muted);font-size:12.5px;margin-top:14px;">
                            Vos données servent uniquement à préparer votre diagnostic
                            (voir la <a href="{{ path('confidentialite') }}" class="link-arrow" style="font-size:12.5px;">politique de confidentialité</a>).
                        </p>
                    </form>
                </div>

                {# ---------- Comment ça marche ---------- #}
                <div class="reveal" data-controller="reveal" data-anim="right" style="transition-delay:80ms;">
                    <div class="surface">
                        <h2 class="h3" style="font-size:1.2rem;margin-bottom:16px;">Ce que vous obtenez</h2>
                        {% for p in ['Un aperçu de vos prochaines échéances (TVA, IS, sociales…)', 'Votre niveau de préparation à la facturation électronique', 'Des recommandations adaptées à votre secteur', 'Aucune carte bancaire, aucun engagement'] %}
                            <div class="check-li">
                                <span class="ic">{{ icon.check(15) }}</span>
                                <span style="color:var(--ink-soft);font-size:15px;line-height:1.5;">{{ p }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
