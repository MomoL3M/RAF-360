{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}Blog — RAF360 : repères pour piloter sereinement{% endblock %}
{% block meta_description %}Analyses, guides et repères pour piloter vos finances : trésorerie, fiscalité, conformité, comptabilité. Les premiers articles de l'équipe RAF360 arrivent prochainement.{% endblock %}

{% block marketing %}
    {% import 'marketing/_icons.html.twig' as icon %}

    {# ===================== HERO ===================== #}
    <section class="page-hero">
        <div class="container">
            <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:18px;">Le blog</div>
            <h1 class="display reveal" data-controller="reveal" style="transition-delay:60ms;max-width:820px;margin-bottom:22px;">Repères pour piloter sereinement</h1>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;max-width:600px;">
                Trésorerie, fiscalité, conformité, comptabilité : nos analyses claires pour transformer la contrainte en avantage.
            </p>
        </div>
    </section>

    {# ===================== ÉTAT VIDE (aucun article inventé, règle 2.10) ===================== #}
    <section class="section" style="padding-top:12px;">
        <div class="container container-narrow">
            <div class="reveal surface" data-controller="reveal" style="text-align:center;">
                <div style="display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:16px;background:var(--paper-2);color:var(--blue-500);margin-bottom:18px;">{{ icon.doc(26) }}</div>
                <h2 class="h2" style="font-size:1.5rem;margin-bottom:12px;">Les premiers articles arrivent</h2>
                <p style="color:var(--muted);font-size:15.5px;line-height:1.6;max-width:520px;margin:0 auto 22px;">
                    Nous préparons des guides pratiques et des analyses vérifiées, sourcées et datées. En attendant,
                    inscrivez-vous à la veille réglementaire ou lancez votre diagnostic gratuit.
                </p>
                <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
                    <a href="{{ path('diagnostic') }}" class="m-btn m-btn-gold">Démarrer le diagnostic gratuit {{ icon.arrowRight(18) }}</a>
                    <a href="{{ path('contact') }}" class="m-btn m-btn-ghost">Être prévenu des publications</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
