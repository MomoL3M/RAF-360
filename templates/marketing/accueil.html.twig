{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}RAF360 — Le poste de pilotage de votre entreprise{% endblock %}
{% block meta_description %}RAF360 centralise le pilotage financier, comptable, fiscal, social et juridique des TPE et PME. Un copilote veille en continu, anticipe les risques et oriente chaque sujet réglementé vers le bon professionnel habilité.{% endblock %}

{% block marketing %}
    {% import 'marketing/_icons.html.twig' as icon %}
    {# ===================== HERO ===================== #}
    <section class="hero">
        <div class="spin-slow" aria-hidden="true" style="position:absolute;top:-180px;right:-160px;width:560px;height:560px;opacity:0.06;pointer-events:none;">
            {{ include('marketing/_logo.html.twig', { size: 560, word: false }) }}
        </div>
        <div class="container">
            <div class="hero-grid">
                <div>
                    <span class="reveal" data-controller="reveal" style="display:inline-block;margin-bottom:22px;">
                        <span class="pill"><span class="pill-dot"></span> Sources officielles françaises uniquement</span>
                    </span>
                    <h1 class="display reveal" data-controller="reveal" style="transition-delay:60ms;margin-bottom:22px;">
                        Le poste de pilotage de votre entreprise, <span class="gold-em">enfin sous contrôle</span>
                    </h1>
                    <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;max-width:540px;margin-bottom:30px;">
                        RAF360 centralise votre pilotage financier, comptable, fiscal, social et juridique. Un copilote veille
                        en continu, anticipe les risques, et oriente chaque sujet réglementé vers le bon professionnel habilité.
                    </p>
                    <div class="reveal" data-controller="reveal" style="transition-delay:180ms;display:flex;gap:14px;flex-wrap:wrap;margin-bottom:26px;">
                        <a href="{{ path('diagnostic') }}" class="m-btn m-btn-gold">Démarrer le diagnostic gratuit {{ icon.arrowRight(18) }}</a>
                        <a href="{{ path('produit') }}" class="m-btn m-btn-ghost">Explorer le produit</a>
                    </div>
                    <div class="reveal" data-controller="reveal" style="transition-delay:240ms;display:flex;gap:22px;flex-wrap:wrap;color:var(--muted);font-size:14px;">
                        {% for t in ['Sans engagement', 'Mise en route rapide', 'Hébergement en Union européenne'] %}
                            <span style="display:inline-flex;align-items:center;gap:7px;"><span style="color:var(--green);display:inline-flex;">{{ icon.check(17) }}</span> {{ t }}</span>
                        {% endfor %}
                    </div>
                </div>

                <div class="reveal" data-controller="reveal" data-anim="scale" style="transition-delay:160ms;position:relative;">
                    <div class="floaty">
                        <div class="product-frame">
                            <div class="inner">
                                <div class="win-dots"><i></i><i></i><i></i></div>
                                <div style="padding:18px 20px 20px;">
                                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                                        <span style="font-size:11.5px;color:var(--muted);font-weight:600;">Trésorerie prévisionnelle · 13 semaines</span>
                                        <span style="font-size:11px;color:var(--green);font-weight:700;display:inline-flex;align-items:center;gap:3px;">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 18l6-7 4 4 6-8"/><path d="M20 7h-4M20 7v4"/></svg>
                                            en progression
                                        </span>
                                    </div>
                                    <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:14px;">
                                        <span style="font-family:var(--font-serif-stack);font-size:28px;font-weight:600;color:var(--green);white-space:nowrap;letter-spacing:-0.02em;">75 000 €</span>
                                        <span style="font-size:12px;color:var(--muted);">solde projeté</span>
                                    </div>
                                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:14px;">
                                        <div style="height:44px;background:var(--paper-3);border-radius:9px;"></div>
                                        <div style="height:44px;background:var(--paper-3);border-radius:9px;"></div>
                                        <div style="height:44px;background:var(--paper-3);border-radius:9px;"></div>
                                    </div>
                                    <svg viewBox="0 0 320 110" width="100%" height="110" role="img" aria-label="Courbe de trésorerie prévisionnelle en progression sur 13 semaines" style="display:block;">
                                        <defs>
                                            <linearGradient id="cashFill" x1="0" y1="0" x2="0" y2="1">
                                                <stop offset="0%" style="stop-color:var(--green);stop-opacity:0.22"/>
                                                <stop offset="100%" style="stop-color:var(--green);stop-opacity:0"/>
                                            </linearGradient>
                                        </defs>
                                        <line x1="0" y1="98" x2="320" y2="98" style="stroke:var(--hairline);stroke-width:1"/>
                                        <path d="M4,90 L48,84 L92,86 L136,72 L180,64 L224,50 L268,40 L312,20 L312,98 L4,98 Z" fill="url(#cashFill)"/>
                                        <path d="M4,90 L48,84 L92,86 L136,72 L180,64 L224,50 L268,40 L312,20" fill="none" stroke-linecap="round" stroke-linejoin="round" style="stroke:var(--green);stroke-width:2.4"/>
                                        <circle cx="312" cy="20" r="4.5" style="fill:var(--green);stroke:#fff;stroke-width:2"/>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="float-card floaty-slow" style="top:-22px;left:-18px;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="width:34px;height:34px;border-radius:10px;background:#e9f6f0;color:var(--green);display:flex;align-items:center;justify-content:center;">{{ icon.shield(18) }}</span>
                            <div>
                                <div style="font-weight:700;color:var(--ink);">Conformité à jour</div>
                                <div style="color:var(--muted);font-size:12px;">Échéances suivies</div>
                            </div>
                        </div>
                    </div>
                    <div class="float-card floaty" style="bottom:-20px;right:-14px;animation-delay:1.5s;">
                        <div style="font-size:11px;color:var(--muted);font-weight:600;">Prévision de trésorerie</div>
                        <div style="font-size:15px;font-weight:700;color:var(--navy);">Anticipée à 13 semaines</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ===================== SOURCES OFFICIELLES ===================== #}
    <section class="section-sm band-soft" style="border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline);">
        <div class="container">
            <p class="reveal" data-controller="reveal" style="text-align:center;color:var(--muted);font-size:13.5px;font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:26px;">
                Nos analyses s'appuient sur les sources officielles françaises
            </p>
            <div class="reveal logo-row" data-controller="reveal" style="transition-delay:80ms;">
                {% for s in ['Légifrance', 'impots.gouv.fr', 'INSEE · SIRENE', 'URSSAF', 'BOFiP', 'net-entreprises'] %}
                    <span>{{ s }}</span>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===================== STATS (fond sombre) ===================== #}
    <section class="section band-dark on-dark">
        <div class="container">
            {% set stats = [
                { to: 360, suffix: '°', label: 'Financier · comptable · fiscal · social · juridique' },
                { to: 5, suffix: ' domaines', label: 'de veille suivis en continu' },
                { to: 100, suffix: ' %', label: 'sources officielles, jamais inventées' },
                { to: 1, suffix: ' SIREN', label: 'suffit pour démarrer' },
            ] %}
            <div class="stats-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px;">
                {% for s in stats %}
                    <div class="reveal" data-controller="reveal" style="transition-delay:{{ loop.index0 * 90 }}ms;text-align:center;">
                        <div class="stat-num" data-controller="countup" data-countup-to-value="{{ s.to }}" data-countup-suffix-value="{{ s.suffix }}">{{ s.to }}{{ s.suffix }}</div>
                        <div class="stat-label">{{ s.label }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===================== FONCTIONNALITÉS ===================== #}
    {% set features = [
        { i: 'sparkle', t: 'Copilote IA sur chaque écran', b: 'Il surveille, alerte, anticipe et propose des scénarios chiffrés avec une recommandation claire — jamais un fait non vérifié.' },
        { i: 'chart', t: 'Trésorerie éclairée', b: 'Position consolidée, réalisée et prévisionnelle. Repérez le point bas des semaines à l\'avance et agissez à temps.' },
        { i: 'calendar', t: 'Échéances maîtrisées', b: 'TVA, IS, DSN, approbation des comptes… chaque obligation est datée, sourcée et priorisée automatiquement.' },
        { i: 'vault', t: 'Coffre-fort documentaire', b: 'Dépôt, OCR et classement automatique par arborescence, avec un score de confiance sur chaque pièce.' },
        { i: 'doc', t: 'Facturation électronique', b: 'Capture, pré-imputation et préparation à la réforme e-facture — outil de gestion compatible, connecté à une plateforme partenaire.' },
        { i: 'users', t: 'Le bon professionnel, au bon moment', b: 'Data room révocable et, à terme, un réseau de professionnels habilités : les sujets réglementés sont orientés, jamais improvisés.' },
    ] %}
    <section class="section" id="features">
        <div class="container">
            <div style="max-width:720px;margin-bottom:52px;">
                <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:16px;">Un système d'exploitation du dirigeant</div>
                <h2 class="h2 reveal" data-controller="reveal" style="transition-delay:60ms;margin-bottom:18px;">Tout ce qui pèse sur vos épaules, réuni et anticipé</h2>
                <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;">
                    RAF360 ne se substitue jamais à un professionnel. Il collecte, contrôle, éclaire vos décisions et vous met
                    en relation avec l'expert habilité quand c'est nécessaire.
                </p>
            </div>
            <div class="feature-grid">
                {% for f in features %}
                    <div class="reveal" data-controller="reveal" style="transition-delay:{{ (loop.index0 % 3) * 90 }}ms;">
                        <div class="feature-card">
                            <div class="feature-ic">
                                {%- if f.i == 'sparkle' %}{{ icon.sparkle(24) }}
                                {%- elseif f.i == 'chart' %}{{ icon.chart(24) }}
                                {%- elseif f.i == 'calendar' %}{{ icon.calendar(24) }}
                                {%- elseif f.i == 'vault' %}{{ icon.vault(24) }}
                                {%- elseif f.i == 'doc' %}{{ icon.doc(24) }}
                                {%- elseif f.i == 'users' %}{{ icon.users(24) }}{% endif -%}
                            </div>
                            <h3>{{ f.t }}</h3>
                            <p>{{ f.b }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===================== COMMENT ÇA MARCHE ===================== #}
    {% set steps = [
        { t: 'Connectez votre entreprise', d: 'Un SIREN suffit : nous récupérons votre forme juridique et vos effectifs (SIRENE/INSEE).' },
        { t: 'Centralisez vos documents', d: 'Par email, mobile ou scanner. L\'OCR classe et contrôle chaque pièce automatiquement.' },
        { t: 'Laissez le copilote veiller', d: 'Il croise trésorerie, échéances et contrats, puis vous alerte et propose des scénarios.' },
        { t: 'Décidez, puis engagez un expert', d: 'Chaque sujet réglementé est routé vers le professionnel habilité, avec un partage limité et tracé.' },
    ] %}
    <section class="section band-paper3">
        <div class="container">
            <div style="text-align:center;max-width:680px;margin:0 auto 54px;">
                <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:16px;justify-content:center;">Comment ça marche</div>
                <h2 class="h2 reveal" data-controller="reveal" style="transition-delay:60ms;">Opérationnel en quatre étapes</h2>
            </div>
            {# Les 4 étapes restent affichées en permanence (pas de gating au scroll) — demande PM. #}
            <div class="steps">
                {% for s in steps %}
                    <div class="step">
                        <span class="step-n">{{ '%02d'|format(loop.index) }}</span>
                        <h3>{{ s.t }}</h3>
                        <p>{{ s.d }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===================== CONFIANCE & CONFORMITÉ ===================== #}
    {% set garanties = [
        ['Sources officielles', 'Légifrance, BOFiP, INSEE, URSSAF — jamais d\'invention.'],
        ['Données protégées', 'Hébergement dans l\'Union européenne, chiffrement, journalisation des accès.'],
        ['Partage révocable', 'Vous choisissez chaque document, limité dans le temps.'],
        ['Escalade humaine', 'Au-delà d\'un seuil, un professionnel prend le relais.'],
    ] %}
    <section class="section band-dark on-dark" id="conformite">
        <div class="container">
            <div class="showcase-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;">
                <div class="reveal" data-controller="reveal" data-anim="left">
                    <span class="eyebrow on-dark" style="margin-bottom:16px;">Confiance &amp; conformité</span>
                    <h2 class="h2" style="margin-bottom:18px;">La conformité réglementaire, par conception</h2>
                    <p class="lead" style="margin-bottom:28px;">
                        RAF360 respecte une séparation stricte entre l'outil (SaaS) et les actes réglementés, confiés aux
                        professionnels habilités. Aucune commission sur leurs honoraires. Vos données restent les vôtres.
                    </p>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                        {% for g in garanties %}
                            <div>
                                <div style="display:flex;align-items:center;gap:9px;margin-bottom:6px;">
                                    <span style="color:var(--gold-400);display:inline-flex;">{{ icon.shield(19) }}</span>
                                    <span style="font-weight:700;color:#fff;font-size:15px;">{{ g[0] }}</span>
                                </div>
                                <p style="color:rgba(219,232,251,0.7);font-size:13.5px;line-height:1.5;">{{ g[1] }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="reveal" data-controller="reveal" data-anim="right" style="transition-delay:100ms;display:flex;justify-content:center;">
                    <div style="position:relative;width:300px;height:300px;">
                        <div class="spin-slow" style="position:absolute;inset:0;opacity:0.9;">
                            {{ include('marketing/_logo.html.twig', { size: 300, word: false }) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ===================== TÉMOIGNAGES (contenus réels à fournir — règle 2.10) ===================== #}
    <section class="section">
        <div class="container">
            <div style="text-align:center;max-width:680px;margin:0 auto 40px;">
                <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:16px;justify-content:center;">Ils pilotent avec RAF360</div>
                <h2 class="h2 reveal" data-controller="reveal" style="transition-delay:60ms;">La sérénité, mesurable</h2>
            </div>
            <div class="reveal surface" data-controller="reveal" style="max-width:640px;margin:0 auto;text-align:center;color:var(--muted);">
                <p style="margin:0;font-size:15px;line-height:1.6;">Les témoignages clients réels seront publiés ici après validation. Aucun avis n'est inventé.</p>
            </div>
        </div>
    </section>

    {# ===================== TARIFS (aperçu — grille R1) ===================== #}
    {% set offres = [
        { name: 'Starter', price: '39 €', period: '/ mois HT', tagline: 'Pour démarrer et y voir clair.', featured: false,
          feats: ['Tableau de bord & échéances', 'Coffre-fort documentaire', 'Copilote IA — alertes', '1 entité'] },
        { name: 'Pilot TPE', price: '129 €', period: '/ mois HT', tagline: 'Le pilotage complet du dirigeant.', featured: true,
          feats: ['Tout Starter', 'Trésorerie prévisionnelle', 'Scénarios & recommandations', 'Préparation à la facturation électronique', 'Data room'] },
        { name: 'RAF PME', price: '349 €', period: '/ mois HT', tagline: 'Pour les PME et leurs équipes.', featured: false,
          feats: ['Tout Pilot TPE', 'Multi-utilisateurs & rôles', 'Accompagnement dédié', 'Support prioritaire'] },
    ] %}
    <section class="section band-soft" id="tarifs">
        <div class="container">
            <div style="text-align:center;max-width:680px;margin:0 auto 52px;">
                <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:16px;justify-content:center;">Tarifs</div>
                <h2 class="h2 reveal" data-controller="reveal" style="transition-delay:60ms;margin-bottom:16px;">Un tarif clair, sans surprise</h2>
                <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;">Essayez sans engagement. Changez ou arrêtez à tout moment.</p>
            </div>
            <div class="price-grid">
                {% for p in offres %}
                    <div class="reveal" data-controller="reveal" style="transition-delay:{{ loop.index0 * 90 }}ms;display:flex;">
                        <div class="price-card {{ p.featured ? 'featured' : '' }}" style="flex:1;">
                            {% if p.featured %}
                                <span class="pill" style="align-self:flex-start;margin-bottom:14px;background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);color:#fff;"><span class="pill-dot"></span> Le plus choisi</span>
                            {% endif %}
                            <div style="font-size:14px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;opacity:0.85;">{{ p.name }}</div>
                            <div style="margin:10px 0 4px;display:flex;align-items:baseline;gap:4px;">
                                <span class="price-amount">{{ p.price }}</span>
                                <span style="font-size:15px;opacity:0.65;">{{ p.period }}</span>
                            </div>
                            <p style="font-size:14px;opacity:0.8;margin-bottom:18px;">{{ p.tagline }}</p>
                            <div style="flex:1;">
                                {% for feat in p.feats %}
                                    <div class="price-feat">{{ icon.check(18) }} <span>{{ feat }}</span></div>
                                {% endfor %}
                            </div>
                            <a href="{{ path('diagnostic') }}" class="m-btn {{ p.featured ? 'm-btn-gold' : 'm-btn-ghost' }}" style="margin-top:22px;width:100%;">Commencer</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <p class="reveal" data-controller="reveal" style="transition-delay:200ms;text-align:center;margin-top:28px;">
                <a href="{{ path('tarifs') }}" class="link-arrow">Voir le détail des offres (dont RAF ETI) {{ icon.arrowRight(17) }}</a>
            </p>
        </div>
    </section>

    {# ===================== CTA FINAL ===================== #}
    <section class="section band-dark on-dark" style="text-align:center;">
        <div class="container container-narrow">
            <h2 class="h2 reveal" data-controller="reveal" style="margin-bottom:20px;">Reprenez la main sur le pilotage de votre entreprise, dès aujourd'hui</h2>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:80ms;margin:0 auto 32px;max-width:620px;">
                Rejoignez les dirigeants qui pilotent sereinement leur entreprise avec RAF360. Diagnostic gratuit, sans engagement.
            </p>
            <div class="reveal" data-controller="reveal" style="transition-delay:140ms;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
                <a href="{{ path('diagnostic') }}" class="m-btn m-btn-gold">Démarrer le diagnostic gratuit {{ icon.arrowRight(18) }}</a>
                <a href="{{ path('produit') }}" class="m-btn m-btn-ghost on-dark">Explorer le produit</a>
            </div>
        </div>
    </section>
{% endblock %}
