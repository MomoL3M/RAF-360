{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}{{ titre }} — RAF360{% endblock %}

{% block marketing %}
    <section class="page-hero">
        <div class="container container-narrow" style="text-align:center;">
            <span class="eyebrow" style="justify-content:center;margin-bottom:16px;">RAF360</span>
            <h1 class="display" style="font-size:clamp(2rem,4vw,3rem);margin-bottom:18px;">{{ titre }}</h1>
            <p class="lead">Cette page est en cours de construction dans le cadre de la refonte du site. Elle sera bientôt disponible.</p>
            <p style="margin-top:28px;">
                <a href="{{ path('accueil') }}" class="m-btn m-btn-ghost">Retour à l'accueil</a>
            </p>
        </div>
    </section>
{% endblock %}
