{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}À propos — RAF360, édité par Lindbergh Formation{% endblock %}
{% block meta_description %}RAF360, édité par Lindbergh Formation SAS, met la puissance d'un directeur financier au service des TPE et PME françaises, dans le strict respect du cadre réglementé.{% endblock %}

{% block marketing %}
    {% import 'marketing/_icons.html.twig' as icon %}

    {% set valeurs = [
        { i: 'shield', t: 'Rigueur réglementaire', d: 'Séparation stricte entre l\'outil et les actes réglementés. Nous préparons ; les professionnels habilités décident et engagent.' },
        { i: 'eye', t: 'Transparence radicale', d: 'Chaque analyse est sourcée et assortie d\'un score de confiance. Rien d\'inventé : ce qui n\'est pas vérifié est signalé comme estimatif.' },
        { i: 'scale', t: 'Indépendance', d: 'Aucune commission sur les honoraires des professionnels. Notre seul intérêt est votre pilotage, pas la vente de prestations tierces.' },
        { i: 'globe', t: 'Ancrage français', d: 'Sources officielles françaises, données hébergées dans l\'Union européenne, conçu pour la réalité des TPE et PME du pays.' },
    ] %}

    {# ===================== HERO ===================== #}
    <section class="page-hero">
        <div class="container">
            <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:18px;">À propos</div>
            <h1 class="display reveal" data-controller="reveal" style="transition-delay:60ms;max-width:900px;margin-bottom:22px;">Mettre la puissance d'un directeur financier entre les mains de chaque dirigeant</h1>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;max-width:640px;">
                Les grandes entreprises ont un directeur administratif et financier. Les TPE et PME, elles, portent tout
                seules. RAF360 comble cet écart — avec la rigueur du métier et le respect absolu du cadre réglementé.
            </p>
        </div>
    </section>

    {# ===================== MISSION ===================== #}
    <section class="section">
        <div class="container">
            <div class="showcase-grid" style="display:grid;grid-template-columns:1.1fr 0.9fr;gap:56px;align-items:center;">
                <div class="reveal" data-controller="reveal" data-anim="left">
                    <span class="eyebrow" style="margin-bottom:16px;">Notre mission</span>
                    <h2 class="h2" style="margin-bottom:18px;">Rendre le pilotage de l'entreprise accessible, fiable et serein</h2>
                    <p class="lead" style="margin-bottom:18px;">
                        RAF360 est édité par <strong style="color:var(--navy-900);">Lindbergh Formation SAS</strong>.
                        Nous réunissons expertise financière, ingénierie logicielle et exigence de conformité pour bâtir
                        un copilote au service du dirigeant.
                    </p>
                    <p class="lead">
                        Notre conviction : la technologie doit préparer et éclairer, jamais remplacer le jugement d'un
                        professionnel habilité. C'est ce principe qui structure chaque décision de conception.
                    </p>
                </div>
                <div class="reveal" data-controller="reveal" data-anim="right" style="transition-delay:100ms;display:flex;justify-content:center;">
                    <div style="position:relative;width:300px;height:300px;display:flex;align-items:center;justify-content:center;">
                        <div aria-hidden="true" style="position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 50% 40%, rgba(143,187,238,0.25), transparent 70%);"></div>
                        <div class="floaty">{{ include('marketing/_logo.html.twig', { size: 220, word: false }) }}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ===================== VALEURS ===================== #}
    <section class="section band-paper3">
        <div class="container">
            <div style="text-align:center;max-width:640px;margin:0 auto 52px;">
                <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:16px;justify-content:center;">Nos valeurs</div>
                <h2 class="h2 reveal" data-controller="reveal" style="transition-delay:60ms;">Ce qui nous engage</h2>
            </div>
            <div class="feature-grid" style="grid-template-columns:repeat(2,1fr);">
                {% for v in valeurs %}
                    <div class="reveal" data-controller="reveal" style="transition-delay:{{ (loop.index0 % 2) * 90 }}ms;">
                        <div class="feature-card" style="display:flex;gap:20px;">
                            <div class="feature-ic" style="margin-bottom:0;flex-shrink:0;">
                                {%- if v.i == 'shield' %}{{ icon.shield(22) }}
                                {%- elseif v.i == 'eye' %}{{ icon.eye(22) }}
                                {%- elseif v.i == 'scale' %}{{ icon.scale(22) }}
                                {%- elseif v.i == 'globe' %}{{ icon.globe(22) }}{% endif -%}
                            </div>
                            <div>
                                <h3>{{ v.t }}</h3>
                                <p>{{ v.d }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===================== STATS ===================== #}
    <section class="section band-dark on-dark">
        <div class="container">
            {% set apStats = [
                { to: 5, suffix: '', label: 'domaines couverts : financier, comptable, fiscal, social, juridique' },
                { to: 100, suffix: ' %', label: 'sources officielles françaises' },
                { to: 0, suffix: '', label: 'commission sur les honoraires des professionnels' },
            ] %}
            <div class="stats-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;">
                {% for s in apStats %}
                    <div class="reveal" data-controller="reveal" style="transition-delay:{{ loop.index0 * 90 }}ms;text-align:center;">
                        <div class="stat-num" data-controller="countup" data-countup-to-value="{{ s.to }}" data-countup-suffix-value="{{ s.suffix }}">{{ s.to }}{{ s.suffix }}</div>
                        <div class="stat-label">{{ s.label }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===================== CTA FINAL ===================== #}
    <section class="section band-dark on-dark" style="text-align:center;padding-top:0;">
        <div class="container container-narrow">
            <h2 class="h2 reveal" data-controller="reveal" style="margin-bottom:20px;">Envie d'en savoir plus ?</h2>
            <div class="reveal" data-controller="reveal" style="transition-delay:100ms;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
                <a href="{{ path('contact') }}" class="m-btn m-btn-gold">Nous contacter {{ icon.arrowRight(18) }}</a>
                <a href="{{ path('produit') }}" class="m-btn m-btn-ghost on-dark">Découvrir le produit</a>
            </div>
        </div>
    </section>
{% endblock %}
