{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}Contact — RAF360{% endblock %}
{% block meta_description %}Une question, une démo, un accompagnement PME/ETI ? Contactez l'équipe RAF360. Réponse sous 24 h ouvrées.{% endblock %}

{% block marketing %}
    {% import 'marketing/_icons.html.twig' as icon %}

    <section class="page-hero">
        <div class="container">
            <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:18px;">Contact</div>
            <h1 class="display reveal" data-controller="reveal" style="transition-delay:60ms;max-width:820px;margin-bottom:22px;">Parlons de votre pilotage</h1>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;max-width:600px;">
                Une question, une demande de démo ou un accompagnement PME/ETI ? Écrivez-nous : nous répondons sous 24 h ouvrées.
            </p>
        </div>
    </section>

    <section class="section" style="padding-top:16px;">
        <div class="container">
            <div class="showcase-grid" style="display:grid;grid-template-columns:1.2fr 0.8fr;gap:48px;align-items:start;">
                {# ---------- Formulaire ---------- #}
                <div class="reveal surface" data-controller="reveal">
                    {% for msg in app.flashes('success') %}
                        <div class="form-alert form-alert-ok" role="status">{{ msg }}</div>
                    {% endfor %}
                    {% if errors._global is defined %}
                        <div class="form-alert form-alert-err" role="alert">{{ errors._global }}</div>
                    {% endif %}

                    <form method="post" action="{{ path('contact') }}" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('lead') }}">
                        <div class="hp-field" aria-hidden="true">
                            <label>Ne remplissez pas ce champ <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
                        </div>

                        <div class="form-grid">
                            <div class="form-row">
                                <label class="form-label" for="nom">Nom *</label>
                                <input class="form-field" id="nom" name="nom" type="text" value="{{ data.nom }}" autocomplete="name" required {% if errors.nom is defined %}aria-invalid="true" aria-describedby="err-nom"{% endif %}>
                                {% if errors.nom is defined %}<p class="form-error" id="err-nom">{{ errors.nom }}</p>{% endif %}
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="email">Email *</label>
                                <input class="form-field" id="email" name="email" type="email" value="{{ data.email }}" autocomplete="email" required {% if errors.email is defined %}aria-invalid="true" aria-describedby="err-email"{% endif %}>
                                {% if errors.email is defined %}<p class="form-error" id="err-email">{{ errors.email }}</p>{% endif %}
                            </div>
                        </div>
                        <div class="form-grid">
                            <div class="form-row">
                                <label class="form-label" for="societe">Société</label>
                                <input class="form-field" id="societe" name="societe" type="text" value="{{ data.societe }}" autocomplete="organization">
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="telephone">Téléphone</label>
                                <input class="form-field" id="telephone" name="telephone" type="tel" value="{{ data.telephone }}" autocomplete="tel">
                            </div>
                        </div>
                        <div class="form-row">
                            <label class="form-label" for="message">Votre message *</label>
                            <textarea class="form-field" id="message" name="message" rows="5" required {% if errors.message is defined %}aria-invalid="true" aria-describedby="err-message"{% endif %}>{{ data.message }}</textarea>
                            {% if errors.message is defined %}<p class="form-error" id="err-message">{{ errors.message }}</p>{% endif %}
                        </div>
                        <button type="submit" class="m-btn m-btn-gold">Envoyer le message {{ icon.arrowRight(18) }}</button>
                        <p style="color:var(--muted);font-size:12.5px;margin-top:14px;">
                            En envoyant ce formulaire, vous acceptez que vos données soient utilisées pour traiter votre demande
                            (voir notre <a href="{{ path('confidentialite') }}" class="link-arrow" style="font-size:12.5px;">politique de confidentialité</a>).
                        </p>
                    </form>
                </div>

                {# ---------- Coordonnées (réelles) ---------- #}
                <div class="reveal" data-controller="reveal" data-anim="right" style="transition-delay:80ms;">
                    <div class="surface">
                        <h2 class="h3" style="font-size:1.2rem;margin-bottom:16px;">Coordonnées</h2>
                        <p style="color:var(--ink-soft);font-size:15px;line-height:1.7;margin-bottom:18px;">
                            <strong style="color:var(--navy-900);">Lindbergh Formation SAS</strong><br>
                            16 rue de Maillé<br>
                            91310 Montlhéry, France
                        </p>
                        <p style="font-size:15px;margin-bottom:8px;">
                            <a href="tel:+33187662097" class="link-arrow">+33 1 87 66 20 97</a>
                        </p>
                        <p style="color:var(--muted);font-size:13.5px;">
                            Email de contact à venir — utilisez le formulaire en attendant.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
