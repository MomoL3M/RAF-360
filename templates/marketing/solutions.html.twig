{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}Solutions — RAF360 pour TPE, PME et experts-comptables{% endblock %}
{% block meta_description %}RAF360 s'adapte à votre réalité : TPE et indépendants, PME en croissance, experts-comptables. Un pilotage financier, comptable, fiscal, social et juridique taillé pour chaque profil.{% endblock %}

{% block marketing %}
    {% import 'marketing/_icons.html.twig' as icon %}

    {% set solutions = [
        { id: 'tpe', i: 'bolt', audience: 'TPE & indépendants', title: 'Y voir clair, sans être expert-comptable',
          body: 'Vous portez tout : la facturation, la TVA, la paie, la trésorerie. RAF360 range, contrôle et vous alerte, pour que vous restiez concentré sur votre métier.',
          points: ['Zéro échéance oubliée : tout est daté et rappelé', 'Trésorerie lisible en un coup d\'œil', 'Documents classés automatiquement', 'Un professionnel à portée de clic quand il le faut'] },
        { id: 'pme', i: 'scale', audience: 'PME en croissance', title: 'Le pilotage d\'un DAF, à l\'échelle de votre PME',
          body: 'Anticipez le besoin en fonds de roulement, comparez des scénarios de financement, sécurisez vos contrats et vos obligations sociales. Le copilote joue le rôle d\'un directeur financier qui ne dort jamais.',
          points: ['Trésorerie prévisionnelle & scénarios chiffrés', 'Suivi multi-comptes et multi-échéances', 'Data room pour vos conseils (avocat, expert-comptable, CAC)', 'Préparation à la facturation électronique'] },
        { id: 'experts', i: 'users', audience: 'Experts-comptables', title: 'Des dossiers clients propres, en continu',
          body: 'Recevez des pièces contrôlées et pré-classées, réduisez les allers-retours et concentrez votre valeur là où elle compte. RAF360 prépare, vous validez.',
          points: ['Multi-entités et espaces collaboratifs', 'Pièces scorées et pré-imputées', 'Marque blanche possible', 'Escalade et validation humaine intégrées'] },
    ] %}

    {# ===================== HERO ===================== #}
    <section class="page-hero">
        <div class="container">
            <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:18px;">Solutions</div>
            <h1 class="display reveal" data-controller="reveal" style="transition-delay:60ms;max-width:880px;margin-bottom:22px;">Un pilotage taillé pour votre réalité</h1>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;max-width:620px;">
                Que vous soyez seul aux commandes ou à la tête d'un cabinet, RAF360 s'adapte à votre niveau d'exigence et à votre organisation.
            </p>
        </div>
    </section>

    {# ===================== SEGMENTS ===================== #}
    {% for s in solutions %}
        {% set reversed = loop.index0 is odd %}
        <section class="section {{ reversed ? 'band-paper3' : '' }}" id="{{ s.id }}">
            <div class="container">
                <div class="showcase-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;">
                    <div class="reveal" data-controller="reveal" data-anim="{{ reversed ? 'right' : 'left' }}" style="order:{{ reversed ? 2 : 1 }};">
                        <span class="pill" style="margin-bottom:18px;">{% if s.i == 'bolt' %}{{ icon.bolt(16) }}{% elseif s.i == 'scale' %}{{ icon.scale(16) }}{% else %}{{ icon.users(16) }}{% endif %} {{ s.audience }}</span>
                        <h2 class="h2" style="margin-bottom:18px;">{{ s.title }}</h2>
                        <p class="lead" style="margin-bottom:24px;">{{ s.body }}</p>
                        <a href="{{ path('diagnostic') }}" class="m-btn m-btn-primary m-btn-sm">Démarrer le diagnostic gratuit {{ icon.arrowRight(16) }}</a>
                    </div>
                    <div class="reveal" data-controller="reveal" data-anim="{{ reversed ? 'left' : 'right' }}" style="transition-delay:100ms;order:{{ reversed ? 1 : 2 }};">
                        <div class="surface">
                            {% for p in s.points %}
                                <div class="check-li">
                                    <span class="ic">{{ icon.check(15) }}</span>
                                    <span style="color:var(--ink-soft);font-size:15.5px;line-height:1.5;">{{ p }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    {% endfor %}

    {# ===================== CTA FINAL ===================== #}
    <section class="section band-dark on-dark" style="text-align:center;">
        <div class="container container-narrow">
            <h2 class="h2 reveal" data-controller="reveal" style="margin-bottom:20px;">Trouvons ensemble la formule adaptée</h2>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:80ms;margin:0 auto 30px;max-width:560px;">
                En 20 minutes, nous cartographions vos obligations et vous montrons ce que RAF360 change au quotidien.
            </p>
            <div class="reveal" data-controller="reveal" style="transition-delay:140ms;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
                <a href="{{ path('diagnostic') }}" class="m-btn m-btn-gold">Démarrer le diagnostic gratuit {{ icon.arrowRight(18) }}</a>
                <a href="{{ path('contact') }}" class="m-btn m-btn-ghost on-dark">Parler à un conseiller</a>
            </div>
        </div>
    </section>
{% endblock %}
