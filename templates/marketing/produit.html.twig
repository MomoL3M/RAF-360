{% extends 'marketing/base_marketing.html.twig' %}

{% block title %}Produit — RAF360 : le copilote de pilotage du dirigeant{% endblock %}
{% block meta_description %}Six modules, un même copilote : trésorerie prévisionnelle, échéances sourcées, coffre-fort documentaire avec OCR, préparation à la facturation électronique et data room. RAF360 prépare et oriente, sans se substituer au professionnel.{% endblock %}

{% block marketing %}
    {% import 'marketing/_icons.html.twig' as icon %}

    {% set modules = [
        { id: 'copilote', i: 'sparkle', kicker: 'Copilote IA', title: 'Un copilote qui anticipe, sur chaque écran',
          body: 'Il surveille en continu votre dossier, croise vos données et vous alerte avant que le problème n\'arrive. Chaque analyse est sourcée, chiffrée et accompagnée d\'un score de confiance.',
          points: ['Alertes prioritaires datées avec montant estimatif', 'Scénarios comparés (avantages / inconvénients) + recommandation', 'Veille juridique, fiscale, sociale et comptable en continu'] },
        { id: 'tresorerie', i: 'chart', kicker: 'Trésorerie', title: 'Voyez le point bas des semaines à l\'avance',
          body: 'Position consolidée multi-comptes, réalisée et prévisionnelle. Ouvrez le détail d\'un mois, zoomez sur une période — et déclenchez le bon levier à temps.',
          points: ['Courbe réalisée + prévisionnelle sur 13 semaines', 'Détail encaissements / décaissements par mois', 'Alertes d\'encaissement client avec mode et date'] },
        { id: 'echeances', i: 'calendar', kicker: 'Échéances', title: 'Plus jamais une obligation oubliée',
          body: 'TVA, IS, DSN, bail, approbation des comptes… Chaque échéance est datée, sourcée, priorisée et préparée. Les retards sont mis en évidence, les acomptes estimés.',
          points: ['Calendrier trié du plus proche au plus lointain', 'Montants estimatifs clairement signalés', 'Brouillons préparés par le copilote'] },
        { id: 'coffre', i: 'vault', kicker: 'Coffre-fort documentaire', title: 'Vos pièces, classées et contrôlées',
          body: 'Déposez par email, mobile ou scanner. L\'OCR lit, classe par arborescence (corporate, business, RH) et attribue un score de confiance — les pièces douteuses sont signalées.',
          points: ['Classement automatique par domaine', 'Score de confiance par document', 'Détection des pièces manquantes'] },
        { id: 'factures', i: 'doc', kicker: 'Factures & e-facture', title: 'Prêt pour la réforme, sans stress',
          body: 'Capture, pré-imputation, détection de doublons et préparation à la facturation électronique via un outil de gestion compatible, connecté à une plateforme partenaire.',
          points: ['Réception des factures électroniques : 1er septembre 2026', 'Émission pour les TPE-PME : 1er septembre 2027', 'Anticipation des relances et du besoin en fonds de roulement'] },
        { id: 'dataroom', i: 'users', kicker: 'Data room & professionnels', title: 'Le bon professionnel, au bon moment',
          body: 'Quand un sujet est réglementé, RAF360 prépare une sélection de documents et pourra vous orienter vers un professionnel habilité. Le partage est limité dans le temps, révocable et journalisé.',
          points: ['Data room : partage tracé, révocable et filigrané', 'Mise en relation avec des professionnels habilités (à venir)', 'Aucune commission sur leurs honoraires'] },
    ] %}

    {# ===================== HERO ===================== #}
    <section class="page-hero">
        <div class="container">
            <div class="eyebrow reveal" data-controller="reveal" style="margin-bottom:18px;">Le produit</div>
            <h1 class="display reveal" data-controller="reveal" style="transition-delay:60ms;max-width:880px;margin-bottom:22px;">Un système d'exploitation pour le dirigeant</h1>
            <p class="lead reveal" data-controller="reveal" style="transition-delay:120ms;max-width:620px;margin-bottom:32px;">
                Six modules, un même fil conducteur : le copilote. Il collecte, contrôle, éclaire vos décisions et vous met
                en relation avec le bon expert — sans jamais s'y substituer.
            </p>
            <div class="reveal" data-controller="reveal" style="transition-delay:180ms;display:flex;gap:14px;flex-wrap:wrap;">
                <a href="{{ path('diagnostic') }}" class="m-btn m-btn-gold">Démarrer le diagnostic gratuit {{ icon.arrowRight(18) }}</a>
                <a href="{{ path('tarifs') }}" class="m-btn m-btn-ghost">Voir les tarifs</a>
            </div>
        </div>
    </section>

    {# ===================== MODULES (alternés) ===================== #}
    {% for m in modules %}
        {% set reversed = loop.index0 is odd %}
        {% set dark = loop.index0 == 2 %}
        {% set band = dark ? 'band-dark on-dark' : (reversed ? 'band-paper3' : '') %}
        <section class="section {{ band }}" id="{{ m.id }}">
            <div class="container">
                <div class="showcase-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;">
                    <div class="reveal" data-controller="reveal" data-anim="{{ reversed ? 'right' : 'left' }}" style="order:{{ reversed ? 2 : 1 }};">
                        <span class="eyebrow {{ dark ? 'on-dark' : '' }}" style="margin-bottom:16px;">{{ m.kicker }}</span>
                        <h2 class="h2" style="margin-bottom:18px;">{{ m.title }}</h2>
                        <p class="lead" style="margin-bottom:24px;">{{ m.body }}</p>
                        <ul style="list-style:none;">
                            {% for p in m.points %}
                                <li class="check-li">
                                    <span class="ic" style="{% if dark %}background:rgba(237,163,35,0.16);color:var(--gold-400);{% endif %}">{{ icon.check(15) }}</span>
                                    <span style="color:{{ dark ? 'rgba(219,232,251,0.9)' : 'var(--ink-soft)' }};font-size:15.5px;line-height:1.5;">{{ p }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div class="reveal" data-controller="reveal" data-anim="{{ reversed ? 'left' : 'right' }}" style="transition-delay:100ms;order:{{ reversed ? 1 : 2 }};display:flex;justify-content:center;">
                        <div class="feature-ic" style="width:200px;height:200px;border-radius:40px;">
                            <span style="display:inline-flex;transform:scale(3.4);">
                                {%- if m.i == 'sparkle' %}{{ icon.sparkle(24) }}
                                {%- elseif m.i == 'chart' %}{{ icon.chart(24) }}
                                {%- elseif m.i == 'calendar' %}{{ icon.calendar(24) }}
                                {%- elseif m.i == 'vault' %}{{ icon.vault(24) }}
                                {%- elseif m.i == 'doc' %}{{ icon.doc(24) }}
                                {%- elseif m.i == 'users' %}{{ icon.users(24) }}{% endif -%}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    {% endfor %}

    {# ===================== CTA FINAL ===================== #}
    <section class="section band-dark on-dark" style="text-align:center;">
        <div class="container container-narrow">
            <h2 class="h2 reveal" data-controller="reveal" style="margin-bottom:20px;">Voyez RAF360 travailler pour vous</h2>
            <div class="reveal" data-controller="reveal" style="transition-delay:100ms;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
                <a href="{{ path('diagnostic') }}" class="m-btn m-btn-gold">Démarrer le diagnostic gratuit {{ icon.arrowRight(18) }}</a>
                <a href="{{ path('tarifs') }}" class="m-btn m-btn-ghost on-dark">Voir les tarifs</a>
            </div>
        </div>
    </section>
{% endblock %}
