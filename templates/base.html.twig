<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}RAF360 — Le copilote financier des TPE et PME{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}RAF360 centralise le pilotage financier, comptable, fiscal, social et juridique des TPE et PME : collecte et contrôle des documents, suivi des échéances, trésorerie éclairée, et orientation vers le bon professionnel habilité.{% endblock %}">

        {% block opengraph %}
            <meta property="og:site_name" content="RAF360">
            <meta property="og:locale" content="fr_FR">
            <meta property="og:type" content="{% block og_type %}website{% endblock %}">
            <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
            <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        {% endblock %}

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧭</text></svg>">

        {# Préchargement des polices principales (LCP + stabilité, §8.3/§8.4) #}
        <link rel="preload" href="{{ asset('fonts/inter-400.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/fraunces-500.woff2') }}" as="font" type="font/woff2" crossorigin>

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
