{# Trésorerie /app — porté de la maquette premium (document autonome, isolé du CSS marketing).
   Courbe réalisée + prévisionnelle en hausse, encaissements/décaissements 2 couleurs,
   infobulle au survol, clic sur un point => tableau détaillé du mois. Données de démonstration. #}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trésorerie — RAF360</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧭</text></svg>">
<style>
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-400.woff2') }}') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-500.woff2') }}') format('woff2');font-weight:500;font-display:swap}
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-600.woff2') }}') format('woff2');font-weight:600;font-display:swap}
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-700.woff2') }}') format('woff2');font-weight:700;font-display:swap}

:root{
  --paper:#eef1f7;--surface:#fff;--surface-2:#f7f9fc;
  --navy-950:#081633;--navy-900:#0d1f4c;--navy-800:#14306b;--navy-700:#1d4487;
  --gold:#c9a227;--gold-400:#e0b53d;--gold-050:#fbf4dd;
  --green:#1f9d6b;--green-050:#e7f6ef;--red:#d64545;--red-050:#fceaea;
  --blue:#2c6fb0;--blue-050:#e9f1fa;--blue-300:#8fbbee;
  --ink:#0f1c34;--ink-soft:#33415c;--slate:#64748b;--hairline:#e5e9f2;
  --sans:'Inter',-apple-system,Segoe UI,Roboto,sans-serif;
  --sh-sm:0 1px 2px rgba(13,31,76,.06),0 1px 3px rgba(13,31,76,.05);
  --sh-md:0 6px 16px rgba(13,31,76,.08),0 2px 6px rgba(13,31,76,.05);
  --sh-lg:0 24px 60px rgba(13,31,76,.16);
  --r:18px;--ease:cubic-bezier(.22,.61,.36,1);
}
*{box-sizing:border-box;margin:0}
body{font-family:var(--sans);color:var(--ink);background:
  radial-gradient(1200px 600px at 100% -5%,rgba(143,187,238,.18),transparent 55%),
  radial-gradient(900px 500px at -10% 0%,rgba(224,181,61,.10),transparent 50%),var(--paper);
  -webkit-font-smoothing:antialiased;min-height:100vh}
.tnum{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}

.shell{display:grid;grid-template-columns:248px 1fr;min-height:100vh}
.side{background:linear-gradient(180deg,var(--navy-900),var(--navy-950));color:#fff;padding:22px 16px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:6px}
.brand{display:flex;align-items:center;gap:10px;padding:6px 8px 18px}
.brand .logo{width:34px;height:34px;border-radius:9px;background:linear-gradient(140deg,var(--gold-400),var(--gold));display:grid;place-items:center;color:var(--navy-950);font-family:var(--sans);font-weight:800;font-size:18px}
.brand b{font-family:var(--sans);font-weight:800;font-size:19px;letter-spacing:-.02em}
.brand b i{color:var(--gold-400);font-style:normal}
.nav{display:flex;flex-direction:column;gap:2px;margin-top:4px}
.nav a{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:11px;color:#c7d3ea;text-decoration:none;font-size:14px;font-weight:500;transition:.2s}
.nav a:hover{background:rgba(255,255,255,.06);color:#fff;transform:translateX(2px)}
.nav a.on{background:linear-gradient(90deg,rgba(224,181,61,.18),rgba(224,181,61,.02));color:#fff;box-shadow:inset 2px 0 0 var(--gold-400)}
.side .spacer{flex:1}
.side .who{display:flex;align-items:center;gap:10px;padding:10px;border-radius:12px;background:rgba(255,255,255,.05)}
.side .who .av{width:32px;height:32px;border-radius:50%;background:linear-gradient(140deg,var(--blue-300),var(--navy-700));display:grid;place-items:center;font-weight:700;font-size:12px;color:#fff}
.side .who small{display:block;color:#9fb1d4;font-size:11px}
.side .who span{font-size:13px;font-weight:600}

.main{padding:26px 30px 60px;min-width:0}
.topline{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.topline h1{font-family:var(--sans);font-weight:800;font-size:30px;letter-spacing:-.03em;color:var(--navy-900)}
.topline p{color:var(--slate);font-size:14px;margin-top:4px}
.demo-pill{display:inline-flex;align-items:center;gap:6px;background:var(--gold-050);color:#8a6d12;border:1px solid #ecd9a0;font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.4px}

.card{background:var(--surface);border:1px solid var(--hairline);border-radius:var(--r);box-shadow:var(--sh-sm);padding:20px;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
.card+.card{margin-top:16px}
.card-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:10px;flex-wrap:wrap}
.card-h .lbl{font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--slate)}

.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:16px}
.kpi .top{font-size:12.5px;color:var(--slate);font-weight:600}
.kpi .val{font-family:var(--sans);font-weight:800;font-size:29px;letter-spacing:-.03em;margin:6px 0 2px;line-height:1.05;white-space:nowrap;font-variant-numeric:tabular-nums}
.kpi .sub{font-size:12px;color:var(--slate)}
.kpi.navy{border-top:3px solid var(--navy-800)}.kpi.navy .val{color:var(--navy-900)}
.kpi.green{border-top:3px solid var(--green)}.kpi.green .val{color:var(--green)}
.kpi.red{border-top:3px solid var(--red)}.kpi.red .val{color:var(--red)}

/* alerte IA */
.alert{position:relative;overflow:hidden;border-radius:22px;color:#eaf0fb;background:radial-gradient(700px 300px at 88% -20%,rgba(31,157,107,.24),transparent 60%),linear-gradient(150deg,var(--navy-800),var(--navy-950));box-shadow:var(--sh-lg);padding:22px 24px;margin-bottom:16px}
.a-tag{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:#9be9c6}
.a-tag .pulse{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(31,157,107,.7);animation:pulse 2.2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(31,157,107,.6)}70%{box-shadow:0 0 0 12px rgba(31,157,107,0)}100%{box-shadow:0 0 0 0 rgba(31,157,107,0)}}
.alert h2{font-family:var(--sans);font-weight:800;font-size:21px;margin:11px 0 8px;color:#fff;letter-spacing:-.02em}
.alert p{font-size:14px;line-height:1.6;color:#cbd7ee;max-width:70ch}
.alert p b{color:#fff}
.reco{margin-top:14px;background:rgba(31,157,107,.14);border:1px solid rgba(31,157,107,.32);border-radius:12px;padding:11px 14px;font-size:13.5px;color:#d8f5e7}
.reco b{color:#9be9c6}
.src{margin-top:12px;font-size:11.5px;color:#8ea1c6}

.chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:6px 11px;border-radius:999px;background:var(--surface-2);color:var(--ink-soft);border:1px solid var(--hairline)}
.legend{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--slate);font-weight:600}
.legend .sw{width:14px;height:14px;border-radius:4px;display:inline-block}
.legend .ln{width:16px;height:3px;border-radius:2px;display:inline-block}

/* graphique */
.chart-wrap{position:relative}
#chart{width:100%;height:auto;display:block;overflow:visible}
.cash-tip{position:absolute;z-index:20;pointer-events:none;background:var(--navy-950);color:#fff;border-radius:12px;padding:11px 13px;font-size:12.5px;line-height:1.55;box-shadow:var(--sh-lg);min-width:168px;opacity:0;transform:translateY(4px);transition:opacity .15s,transform .15s}
.cash-tip.show{opacity:1;transform:none}
.cash-tip .th{font-weight:800;margin-bottom:5px;font-size:13px}
.cash-tip .li{display:flex;justify-content:space-between;gap:14px}
.cash-tip .li .k{color:#9fb1d4}
.cash-tip .dotg{color:#6ee0ac}.cash-tip .dotr{color:#ffa2a2}
.chart-hint{font-size:12.5px;color:var(--slate);margin-top:8px}

/* détail du mois */
.detail-empty{margin-top:16px;background:var(--surface-2);border:1px dashed var(--hairline);border-radius:14px;padding:16px 18px;color:var(--slate);font-size:13.5px}
.detail{margin-top:16px;background:var(--surface-2);border:1px solid var(--hairline);border-radius:16px;padding:20px;opacity:0;transform:translateY(8px);transition:opacity .35s var(--ease),transform .35s var(--ease)}
.detail.in{opacity:1;transform:none}
.detail-h{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.detail-h .t{font-family:var(--sans);font-weight:800;font-size:17px;color:var(--navy-900);letter-spacing:-.02em}
.badge{font-size:11.5px;font-weight:700;padding:5px 11px;border-radius:999px}
.badge.green{background:var(--green-050);color:var(--green)}
.badge.gold{background:var(--gold-050);color:#8a6d12}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}
.dh{font-size:11.5px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.dh.enc{color:var(--green)}.dh.dec{color:var(--red)}
.drow{display:flex;justify-content:space-between;padding:8px 0;font-size:13.5px;border-bottom:1px solid var(--hairline)}
.drow .k{color:var(--slate)}.drow .v{font-weight:700;font-variant-numeric:tabular-nums}
.dtot{display:flex;justify-content:space-between;margin-top:14px;padding-top:14px;border-top:2px solid var(--hairline);font-size:14px}
.dtot .v{font-weight:800;font-variant-numeric:tabular-nums}

/* alertes encaissement */
.al{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;margin-bottom:9px}
.al:last-child{margin-bottom:0}
.al.warn{background:var(--red-050)}
.al.ok{background:var(--blue-050)}
.al .c{font-size:14px;font-weight:600;color:var(--ink)}
.al .m{font-size:12px;color:var(--slate);margin-top:2px}
.al .amt{font-weight:800;font-variant-numeric:tabular-nums}
.al .badge2{font-size:11px;font-weight:700;padding:5px 10px;border-radius:999px;white-space:nowrap}
.al.warn .amt,.al.warn .badge2{color:var(--red)}.al.warn .badge2{background:#fff}
.al.ok .amt{color:var(--navy-800)}.al.ok .badge2{background:#fff;color:var(--navy-800)}

.rise{opacity:0;transform:translateY(20px)}
.rise.in{opacity:1;transform:none;transition:opacity .7s var(--ease),transform .7s var(--ease)}
.demo-badge{position:fixed;right:14px;bottom:14px;z-index:99;background:var(--navy-900);color:#fff;font:600 12px/1.4 var(--sans);padding:9px 13px;border-radius:10px;box-shadow:var(--sh-md);opacity:.92}

@media(max-width:1080px){.kpis{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr;gap:16px}}
@media(max-width:760px){.shell{grid-template-columns:1fr}.side{position:static;height:auto;flex-direction:row;flex-wrap:wrap}.side .spacer,.side .who{display:none}.nav{flex-direction:row;flex-wrap:wrap}.main{padding:20px 16px 50px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rise,.detail{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="shell">
  <aside class="side">
    <div class="brand"><span class="logo">R</span><b>RAF<i>360</i></b></div>
    <nav class="nav">
      <a href="{{ path('app_dashboard') }}">Tableau de bord</a>
      <a href="#" class="on">◆ Trésorerie</a>
      <a href="{{ path('app_calendar') }}">Échéances</a>
      <a href="{{ path('app_documents') }}">Documents</a>
      <a href="{{ path('app_factures') }}">Factures</a>
      <a href="{{ path('app_dataroom') }}">Data room</a>
      <a href="{{ path('app_actions') }}">Actions</a>
      <a href="{{ path('app_assistant') }}">Copilote IA</a>
    </nav>
    <div class="spacer"></div>
    <div class="who"><span class="av">ML</span><div><span>Ma société</span><small>Dirigeant</small></div></div>
  </aside>

  <main class="main">
    <div class="topline">
      <div>
        <h1>Trésorerie</h1>
        <p>Position consolidée, réalisée et prévisionnelle — simulation à valider, non comptable.</p>
      </div>
      <span class="demo-pill">● Données de démonstration</span>
    </div>

    <!-- KPI -->
    <div class="kpis">
      <div class="card kpi navy rise"><div class="top">Solde de trésorerie disponible</div><div class="val tnum"><span data-count="131200" data-suffix=" €">0 €</span></div><div class="sub">3 comptes bancaires</div></div>
      <div class="card kpi green rise"><div class="top">Encaissements du mois</div><div class="val tnum"><span data-count="67000" data-suffix=" €">0 €</span></div><div class="sub">Novembre 2025</div></div>
      <div class="card kpi red rise"><div class="top">Décaissements du mois</div><div class="val tnum"><span data-count="56000" data-suffix=" €">0 €</span></div><div class="sub">Novembre 2025</div></div>
    </div>

    <!-- Alerte IA (trajectoire en hausse) -->
    <section class="alert rise">
      <span class="a-tag"><span class="pulse"></span> Anticipation · Copilote</span>
      <h2>Trajectoire de trésorerie en amélioration</h2>
      <p>Sur les 12 mois, les <b>encaissements dépassent les décaissements</b> chaque mois : le solde projeté progresse de <b>131 k€ (nov.) à 176 k€ (fév.)</b>. Le copilote confirme une dynamique saine, sans point bas critique sur la période.</p>
      <div class="reco"><b>Recommandation :</b> sécuriser l'excédent (placement court terme ou remboursement anticipé) tout en conservant un matelas ≥ 60 k€ ; réévaluer à la prochaine grosse échéance fiscale.</div>
      <div class="src">Prévision 13 semaines · échéancier fournisseurs · <b style="color:#9be9c6">confiance 85 %</b></div>
    </section>

    <!-- Graphique -->
    <div class="card rise">
      <div class="card-h">
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <span class="chip">📅 Mars 2025 – Févr. 2026</span>
          <span class="chip">🏦 Tous les comptes</span>
        </div>
        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <span class="legend"><span class="sw" style="background:var(--green)"></span> Encaissements</span>
          <span class="legend"><span class="sw" style="background:var(--red)"></span> Décaissements</span>
          <span class="legend"><span class="ln" style="background:var(--navy-800)"></span> Solde réalisé</span>
          <span class="legend"><span class="ln" style="background:var(--gold);border-top:3px dashed var(--gold);height:0"></span> Solde prévisionnel</span>
        </div>
      </div>
      <div class="chart-wrap">
        <svg id="chart" viewBox="0 0 720 300" role="img" aria-label="Courbe de trésorerie réalisée et prévisionnelle, en hausse"></svg>
        <div class="cash-tip" id="tip"></div>
      </div>
      <div class="chart-hint">Survolez un point pour le détail ; cliquez sur un point pour générer le tableau détaillé du mois.</div>
      <div class="detail-empty" id="detail">👆 Cliquez sur un point de la courbe pour afficher le détail du mois (encaissements / décaissements).</div>
    </div>

    <!-- Alertes d'encaissement -->
    <div class="card rise">
      <div class="card-h"><span class="lbl">Alertes d'encaissement</span></div>
      <div id="alerts"></div>
    </div>
  </main>
</div>
<div class="demo-badge">Maquette premium · données de démonstration</div>

<script>{% verbatim %}
/* ===== données démo (k€), en hausse ===== */
const LAB=['Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc','Jan','Fév'];
const YR =['25','25','25','25','25','25','25','25','25','25','26','26'];
const SOL=[58,66,73,81,88,96,105,116,127,141,158,176];   // solde, monte
const ENC=[46,49,52,55,57,60,63,67,71,76,82,90];         // encaissements
const DEC=[39,42,45,47,49,51,54,56,60,63,66,72];         // décaissements
const REAL=8;                                            // 0..7 réalisé, 8..11 prévisionnel (Nov = dernier réalisé index 8? -> réalisé jusqu'à index 8)
const realIdx=8;

const CAT_E=[['Ventes / prestations',.78],['Subventions & aides',.09],['Autres encaissements',.13]];
const CAT_S=[['Salaires & charges',.46],['Fournisseurs',.34],['Fiscalité & prêts',.20]];

const ALERTS=[
 {c:'Client ACME',m:'12 000 €',mode:'Virement',d:'20 fév. 2026',st:'warn'},
 {c:'Client BÊTA',m:'6 400 €',mode:'Prélèvement',d:'02 mars 2026',st:'ok'},
 {c:'Client GAMMA',m:'3 900 €',mode:'Chèque',d:'11 mars 2026',st:'ok'}
];
const al=document.getElementById('alerts');
ALERTS.forEach(a=>al.insertAdjacentHTML('beforeend',
 `<div class="al ${a.st}"><div><div class="c">${a.c} — <span class="amt">${a.m}</span></div><div class="m">${a.mode} · échéance ${a.d}</div></div>`+
 `<span class="badge2">${a.st==='warn'?'En retard':'Attendu'}</span></div>`));

/* ===== count-up ===== */
function countUp(el){const to=+el.dataset.count,suf=el.dataset.suffix||'',t0=performance.now(),dur=1300;
 (function s(n){const p=Math.min(1,(n-t0)/dur),e=1-Math.pow(1-p,3);el.textContent=Math.round(to*e).toLocaleString('fr-FR')+suf;if(p<1)requestAnimationFrame(s);})(t0);}

/* ===== graphique ===== */
const svg=document.getElementById('chart'),tip=document.getElementById('tip'),wrap=svg.parentNode,detail=document.getElementById('detail');
const W=720,H=300,padL=48,padR=16,padT=16,padB=42;
const plotW=W-padL-padR,plotH=H-padT-padB;
const maxV=Math.max(...ENC,...DEC,...SOL)*1.12;
const yOf=v=>padT+plotH-(v/maxV)*plotH;
const n=SOL.length,band=plotW/n,cx=k=>padL+band*(k+0.5);
let selected=null;

function build(){
 let s='';
 // grille + axe Y
 for(let t=0;t<=5;t++){const v=maxV*t/5,y=yOf(v);s+=`<line x1="${padL}" y1="${y.toFixed(1)}" x2="${W-padR}" y2="${y.toFixed(1)}" stroke="#eef1f7"/><text x="${padL-8}" y="${(y+4).toFixed(1)}" text-anchor="end" font-size="10" fill="#94a3b8">${Math.round(v)}k€</text>`;}
 // barres enc (vert) / dec (rouge)
 const bw=band*0.22;
 for(let k=0;k<n;k++){const c=cx(k),real=k<=realIdx;
  const he=(ENC[k]/maxV)*plotH,hd=(DEC[k]/maxV)*plotH;
  s+=`<rect class="bar" data-fh="${he.toFixed(1)}" x="${(c-bw-2).toFixed(1)}" y="${(padT+plotH).toFixed(1)}" width="${bw.toFixed(1)}" height="0" rx="2" fill="#1f9d6b" opacity="${real?.78:.42}"/>`;
  s+=`<rect class="bar" data-fh="${hd.toFixed(1)}" x="${(c+2).toFixed(1)}" y="${(padT+plotH).toFixed(1)}" width="${bw.toFixed(1)}" height="0" rx="2" fill="#d64545" opacity="${real?.7:.38}"/>`;
 }
 // lignes solde : réalisé (plein navy) + prévisionnel (pointillé or)
 const rp=[],fp=[];
 for(let k=0;k<n;k++){const p=`${cx(k).toFixed(1)},${yOf(SOL[k]).toFixed(1)}`;if(k<=realIdx)rp.push(p);if(k>=realIdx)fp.push(p);}
 s+=`<polyline class="ln" points="${rp.join(' ')}" fill="none" stroke="#14306b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="1" style="stroke-dasharray:1;stroke-dashoffset:1"/>`;
 s+=`<polyline class="ln2" points="${fp.join(' ')}" fill="none" stroke="#c9a227" stroke-width="3" stroke-dasharray="6 5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" style="stroke-dashoffset:1"/>`;
 // axes
 s+=`<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT+plotH}" stroke="#94a3b8"/><line x1="${padL}" y1="${padT+plotH}" x2="${W-padR}" y2="${padT+plotH}" stroke="#94a3b8"/>`;
 // points + labels
 for(let k=0;k<n;k++){const c=cx(k),y=yOf(SOL[k]),real=k<=realIdx;
  s+=`<circle class="pt" data-i="${k}" cx="${c.toFixed(1)}" cy="${y.toFixed(1)}" r="0" fill="${real?'#14306b':'#c9a227'}" stroke="#fff" stroke-width="2" style="cursor:pointer"/>`;
  s+=`<text x="${c.toFixed(1)}" y="${H-padB+16}" text-anchor="middle" font-size="10" fill="#64748b">${LAB[k]}</text>`;
  s+=`<text x="${c.toFixed(1)}" y="${H-padB+28}" text-anchor="middle" font-size="9" fill="#94a3b8">'${YR[k]}</text>`;
 }
 svg.innerHTML=s;
 bindPoints();
}

function animateChart(){
 svg.querySelectorAll('.bar').forEach((b,i)=>{setTimeout(()=>{b.style.transition='height .8s var(--ease),y .8s var(--ease)';const fh=+b.dataset.fh;b.setAttribute('height',fh);b.setAttribute('y',(padT+plotH-fh).toFixed(1));},i*22);});
 const a=svg.querySelector('.ln'),b=svg.querySelector('.ln2');
 a.style.transition='stroke-dashoffset 1.1s ease';a.style.strokeDashoffset='0';
 b.style.transition='stroke-dashoffset 1.1s ease .9s';b.style.strokeDashoffset='0';
 svg.querySelectorAll('.pt').forEach((p,i)=>{setTimeout(()=>{p.style.transition='r .3s var(--ease)';p.setAttribute('r','4.5');},700+i*45);});
}

function bindPoints(){
 svg.querySelectorAll('.pt').forEach(p=>{
  const i=+p.dataset.i;
  p.addEventListener('mouseenter',e=>showTip(i,e));
  p.addEventListener('mousemove',e=>moveTip(e));
  p.addEventListener('mouseleave',hideTip);
  p.addEventListener('click',()=>pick(i));
 });
}
function showTip(i,e){const real=i<=realIdx;
 tip.innerHTML=`<div class="th">${LAB[i]} 20${YR[i]} — ${real?'réalisé':'prévisionnel'}</div>`+
  `<div class="li"><span class="k">Solde</span><b>${SOL[i]} k€</b></div>`+
  `<div class="li"><span class="k dotg">Encaissements</span><span>${ENC[i]} k€</span></div>`+
  `<div class="li"><span class="k dotr">Décaissements</span><span>${DEC[i]} k€</span></div>`+
  `<div class="li" style="margin-top:4px"><span class="k">Solde net</span><b style="color:#6ee0ac">+${ENC[i]-DEC[i]} k€</b></div>`;
 tip.classList.add('show');moveTip(e);}
function moveTip(e){const r=wrap.getBoundingClientRect();let x=e.clientX-r.left+14,y=e.clientY-r.top-10;
 if(x+180>r.width)x=e.clientX-r.left-180;tip.style.left=x+'px';tip.style.top=y+'px';}
function hideTip(){tip.classList.remove('show');}

function pick(i){selected=(selected===i)?null:i;renderDetail();}
function renderDetail(){
 svg.querySelectorAll('.pt').forEach(p=>p.setAttribute('r',(+p.dataset.i===selected)?'6.5':'4.5'));
 if(selected===null){detail.className='detail-empty';detail.innerHTML='👆 Cliquez sur un point de la courbe pour afficher le détail du mois (encaissements / décaissements).';return;}
 const i=selected,real=i<=realIdx,debut=i===0?40:SOL[i-1],net=ENC[i]-DEC[i];
 const rows=(cat,val,cls)=>cat.map(x=>`<div class="drow"><span class="k">${x[0]}</span><span class="v" style="color:var(--${cls})">${Math.round(val*x[1])} k€</span></div>`).join('');
 detail.className='detail';
 detail.innerHTML=
  `<div class="detail-h"><div class="t">${LAB[i]} 20${YR[i]} — détail ${real?'(réalisé)':'(prévisionnel)'}</div>`+
  `<span class="badge ${real?'green':'gold'}">${real?'Trésorerie fonctionnelle':'Trésorerie prévisionnelle'}</span></div>`+
  `<div class="detail-grid">`+
    `<div><div class="dh enc">Encaissements — ${ENC[i]} k€</div>${rows(CAT_E,ENC[i],'green')}</div>`+
    `<div><div class="dh dec">Décaissements — ${DEC[i]} k€</div>${rows(CAT_S,DEC[i],'red')}</div>`+
  `</div>`+
  `<div class="dtot"><span class="k" style="color:var(--slate)">Solde net du mois · début ${debut} k€ → fin</span>`+
   `<span class="v" style="color:${net>=0?'var(--green)':'var(--red)'}">${net>=0?'+':''}${net} k€ · ${SOL[i]} k€</span></div>`;
 requestAnimationFrame(()=>detail.classList.add('in'));
 detail.scrollIntoView({behavior:'smooth',block:'nearest'});
}

/* ===== apparition ===== */
build();
const seen=new WeakSet();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting||seen.has(e.target))return;seen.add(e.target);
 e.target.classList.add('in');
 e.target.querySelectorAll?.('[data-count]').forEach(countUp);
 if(e.target.querySelector?.('#chart'))animateChart();
}),{threshold:.2});
document.querySelectorAll('.rise').forEach((c,i)=>{c.style.transitionDelay=(Math.min(i,6)*55)+'ms';io.observe(c);});
{% endverbatim %}</script>
