{# Écran /app « dataroom » — porté de la maquette premium (document autonome, isolé du CSS marketing). Données de démonstration. #}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Data room — RAF360</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧭</text></svg>">
<style>
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-400.woff2') }}') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-500.woff2') }}') format('woff2');font-weight:500;font-display:swap}
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-600.woff2') }}') format('woff2');font-weight:600;font-display:swap}
@font-face{font-family:'Inter';src:url('{{ asset('fonts/inter-700.woff2') }}') format('woff2');font-weight:700;font-display:swap}

:root{
  --paper:#eef1f7;--surface:#fff;--surface-2:#f7f9fc;
  --navy-950:#081633;--navy-900:#0d1f4c;--navy-800:#14306b;--navy-700:#1d4487;
  --gold:#c9a227;--gold-400:#e0b53d;--gold-050:#fbf4dd;
  --green:#1f9d6b;--green-050:#e7f6ef;--red:#d64545;--red-050:#fceaea;
  --blue:#2c6fb0;--blue-050:#e9f1fa;--blue-300:#8fbbee;
  --ink:#0f1c34;--ink-soft:#33415c;--slate:#64748b;--hairline:#e5e9f2;
  --sans:'Inter',-apple-system,Segoe UI,Roboto,sans-serif;
  --sh-sm:0 1px 2px rgba(13,31,76,.06),0 1px 3px rgba(13,31,76,.05);
  --sh-md:0 6px 16px rgba(13,31,76,.08),0 2px 6px rgba(13,31,76,.05);
  --sh-lg:0 24px 60px rgba(13,31,76,.16);
  --r:18px;--ease:cubic-bezier(.22,.61,.36,1);
}
*{box-sizing:border-box;margin:0}
body{font-family:var(--sans);color:var(--ink);background:
  radial-gradient(1200px 600px at 100% -5%,rgba(143,187,238,.18),transparent 55%),
  radial-gradient(900px 500px at -10% 0%,rgba(224,181,61,.10),transparent 50%),var(--paper);
  -webkit-font-smoothing:antialiased;min-height:100vh}
.tnum{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}

.shell{display:grid;grid-template-columns:248px 1fr;min-height:100vh}
.side{background:linear-gradient(180deg,var(--navy-900),var(--navy-950));color:#fff;padding:22px 16px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:6px}
.brand{display:flex;align-items:center;gap:10px;padding:6px 8px 18px}
.brand .logo{width:34px;height:34px;border-radius:9px;background:linear-gradient(140deg,var(--gold-400),var(--gold));display:grid;place-items:center;color:var(--navy-950);font-family:var(--sans);font-weight:800;font-size:18px}
.brand b{font-family:var(--sans);font-weight:800;font-size:19px;letter-spacing:-.02em}
.brand b i{color:var(--gold-400);font-style:normal}
.nav{display:flex;flex-direction:column;gap:2px;margin-top:4px}
.nav a{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:11px;color:#c7d3ea;text-decoration:none;font-size:14px;font-weight:500;transition:.2s}
.nav a:hover{background:rgba(255,255,255,.06);color:#fff;transform:translateX(2px)}
.nav a.on{background:linear-gradient(90deg,rgba(224,181,61,.18),rgba(224,181,61,.02));color:#fff;box-shadow:inset 2px 0 0 var(--gold-400)}
.side .spacer{flex:1}
.side .who{display:flex;align-items:center;gap:10px;padding:10px;border-radius:12px;background:rgba(255,255,255,.05)}
.side .who .av{width:32px;height:32px;border-radius:50%;background:linear-gradient(140deg,var(--blue-300),var(--navy-700));display:grid;place-items:center;font-weight:700;font-size:12px;color:#fff}
.side .who small{display:block;color:#9fb1d4;font-size:11px}
.side .who span{font-size:13px;font-weight:600}

.main{padding:26px 30px 60px;min-width:0}
.topline{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.topline h1{font-family:var(--sans);font-weight:800;font-size:30px;letter-spacing:-.03em;color:var(--navy-900)}
.topline p{color:var(--slate);font-size:14px;margin-top:4px}
.demo-pill{display:inline-flex;align-items:center;gap:6px;background:var(--gold-050);color:#8a6d12;border:1px solid #ecd9a0;font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.4px}

.card{background:var(--surface);border:1px solid var(--hairline);border-radius:var(--r);box-shadow:var(--sh-sm);padding:20px}
.card-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:10px;flex-wrap:wrap}
.card-h .lbl{font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--slate)}

.kpis{display:grid;gap:16px;margin-bottom:16px}
.kpis.k3{grid-template-columns:repeat(3,1fr)}
.kpis.k4{grid-template-columns:repeat(4,1fr)}
.kpi .top{font-size:12px;color:var(--slate);font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.kpi .val{font-family:var(--sans);font-weight:800;font-size:30px;letter-spacing:-.03em;margin:7px 0 2px;line-height:1;font-variant-numeric:tabular-nums;color:var(--navy-900)}
.kpi .val.red{color:var(--red)}.kpi .val.green{color:var(--green)}.kpi .val.gold{color:#8a6d12}
.kpi .sub{font-size:12px;color:var(--slate)}

.alert{position:relative;overflow:hidden;border-radius:22px;color:#eaf0fb;background:radial-gradient(700px 300px at 88% -20%,rgba(44,111,176,.26),transparent 60%),linear-gradient(150deg,var(--navy-800),var(--navy-950));box-shadow:var(--sh-lg);padding:22px 24px;margin-bottom:16px}
.alert.gold{background:radial-gradient(700px 300px at 88% -20%,rgba(224,181,61,.24),transparent 60%),linear-gradient(150deg,var(--navy-800),var(--navy-950))}
.a-tag{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:#9fc7f2}
.alert.gold .a-tag{color:#ffd98a}
.a-tag .pulse{width:9px;height:9px;border-radius:50%;background:var(--blue-300);box-shadow:0 0 0 0 rgba(143,187,238,.7);animation:pulse 2.2s infinite}
.alert.gold .a-tag .pulse{background:var(--gold-400);box-shadow:0 0 0 0 rgba(224,181,61,.7)}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(143,187,238,.55)}70%{box-shadow:0 0 0 12px rgba(143,187,238,0)}100%{box-shadow:0 0 0 0 rgba(143,187,238,0)}}
.alert h2{font-family:var(--sans);font-weight:800;font-size:20px;margin:11px 0 8px;color:#fff;letter-spacing:-.02em}
.alert p{font-size:14px;line-height:1.6;color:#cbd7ee;max-width:74ch}
.alert p b{color:#fff}
.a-cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.btn{border:0;border-radius:11px;font:700 13px/1 var(--sans);padding:11px 15px;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:transform .2s,box-shadow .2s,background .2s}
.btn-gold{background:linear-gradient(135deg,var(--gold-400),var(--gold));color:var(--navy-950);box-shadow:0 8px 20px rgba(201,162,39,.32)}
.btn-gold:hover{transform:translateY(-2px)}
.btn-ghost{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.18)}
.btn-ghost:hover{background:rgba(255,255,255,.15)}
.src{margin-top:12px;font-size:11.5px;color:#8ea1c6}

.badge{font-size:11.5px;font-weight:700;padding:5px 11px;border-radius:999px;white-space:nowrap}
.badge.navy{background:var(--blue-050);color:var(--navy-800)}
.badge.green{background:var(--green-050);color:var(--green)}
.badge.gold{background:var(--gold-050);color:#8a6d12}
.badge.red{background:var(--red-050);color:var(--red)}
.badge.slate{background:#eef1f7;color:var(--ink-soft)}

.rise{opacity:0;transform:translateY(20px)}
.rise.in{opacity:1;transform:none;transition:opacity .7s var(--ease),transform .7s var(--ease)}
.demo-badge{position:fixed;right:14px;bottom:14px;z-index:99;background:var(--navy-900);color:#fff;font:600 12px/1.4 var(--sans);padding:9px 13px;border-radius:10px;box-shadow:var(--sh-md);opacity:.92}

@media(max-width:1080px){.kpis.k4{grid-template-columns:1fr 1fr}.kpis.k3{grid-template-columns:1fr}}
@media(max-width:760px){.shell{grid-template-columns:1fr}.side{position:static;height:auto;flex-direction:row;flex-wrap:wrap}.side .spacer,.side .who{display:none}.nav{flex-direction:row;flex-wrap:wrap}.main{padding:20px 16px 50px}.kpis.k4,.kpis.k3{grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rise{opacity:1;transform:none}}

</style>
<style>
.grid-half{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:980px){.grid-half{grid-template-columns:1fr}}
.dom{border-bottom:1px solid var(--hairline)}
.dom:last-child{border-bottom:0}
.tree-row{width:100%;display:flex;align-items:center;gap:11px;padding:14px 16px;background:none;border:0;cursor:pointer;font:inherit;text-align:left;transition:background .2s}
.tree-row:hover{background:var(--surface-2)}
.tree-caret{color:var(--slate);font-size:11px;transition:transform .25s var(--ease)}
.tree-caret.open{transform:rotate(90deg)}
.tree-row .fl{font-size:14px;font-weight:700;color:var(--navy-900);flex:1}
.dom-body{overflow:hidden;max-height:0;transition:max-height .35s var(--ease)}
.pro-row{display:flex;align-items:center;gap:12px;padding:12px 16px 12px 40px;border-top:1px solid var(--hairline)}
.avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(140deg,var(--blue-300),var(--navy-700));color:#fff;display:grid;place-items:center;font-weight:800;font-size:13px;flex-shrink:0}
.pro-row .pn{font-size:14px;color:var(--ink);font-weight:600}
.pro-row .pr{font-size:12px;color:var(--slate)}
.btn-rdv{border:0;background:var(--navy-900);color:#fff;font:700 12px/1 var(--sans);padding:8px 12px;border-radius:9px;cursor:pointer;white-space:nowrap;transition:.2s}
.btn-rdv:hover{background:var(--navy-800)}
.slots{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
.slot{border:1px solid var(--hairline);border-radius:10px;padding:11px;text-align:center;font-size:13px;font-weight:600;color:var(--ink-soft);cursor:pointer;transition:.2s}
.slot:hover{border-color:var(--blue-300)}
.slot.sel{background:var(--navy-900);color:#fff;border-color:var(--navy-900)}
.empty{padding:18px;background:var(--surface-2);border-radius:12px;text-align:center}
.dh{font-size:12px;font-weight:700;color:var(--slate);text-transform:uppercase;letter-spacing:.4px;margin:14px 0 8px}
</style>
</head>
<body>
<div class="shell">
  <aside class="side">
    <div class="brand"><span class="logo">R</span><b>RAF<i>360</i></b></div>
    <nav class="nav">
      <a href="{{ path('app_dashboard') }}">Tableau de bord</a>
      <a href="{{ path('app_treasury') }}">Trésorerie</a>
      <a href="{{ path('app_calendar') }}">Échéances</a>
      <a href="{{ path('app_documents') }}">Documents</a>
      <a href="{{ path('app_factures') }}">Factures</a>
      <a href="{{ path('app_dataroom') }}" class="on">◆ Data room</a>
      <a href="{{ path('app_actions') }}">Actions</a>
      <a href="{{ path('app_assistant') }}">Copilote IA</a>
    </nav>
    <div class="spacer"></div>
    <div class="who"><span class="av">ML</span><div><span>Ma société</span><small>Dirigeant</small></div></div>
  </aside>

  <main class="main">
    <div class="topline">
      <div>
        <h1>Data room &amp; professionnels</h1>
        <p>Partage volontaire, limité et révocable — vous choisissez chaque document.</p>
      </div>
      <span class="demo-pill">● Données de démonstration</span>
    </div>

    <section class="alert rise">
      <span class="a-tag"><span class="pulse"></span> Suggestion de routage · Copilote</span>
      <h2>Un avocat en droit des affaires est recommandé</h2>
      <p>La clause de responsabilité du contrat BÉTA sort de vos usages habituels. Le copilote suggère <b>Me Sophie Lambert</b> (droit des sociétés, dispo sous 72 h) et a préparé la sélection de documents à partager.</p>
      <div class="a-cta"><button class="btn btn-ghost">Voir le dossier BÉTA</button><button class="btn btn-gold" id="ctaRdv">Prendre rendez-vous</button></div>
    </section>

    <div class="grid-half">
      <div class="card rise" style="padding:0">
        <div style="padding:14px 16px;font-size:14px;font-weight:700;color:var(--navy-900);border-bottom:1px solid var(--hairline);display:flex;align-items:center;justify-content:space-between;gap:8px">
          Réseau de professionnels par domaine <span class="badge gold">à venir</span>
        </div>
        <div id="pros"></div>
      </div>

      <div class="card rise">
        <div class="card-h"><span class="lbl">Prise de rendez-vous</span></div>
        <div id="rdv">
          <div class="empty"><div style="font-size:14px;color:var(--ink);font-weight:600">Sélectionnez un professionnel</div>
            <div style="font-size:12.5px;color:var(--slate);margin-top:6px">Choisissez un domaine à gauche puis « Rendez-vous » pour ouvrir un créneau et une salle de décision.</div></div>
        </div>
        <div style="margin-top:14px;font-size:12px;color:var(--slate)">🔒 Chaque partage est limité dans le temps, révocable et journalisé (qui a vu quoi, quand). Aucune commission sur les honoraires du professionnel.</div>
      </div>
    </div>
  </main>
</div>
<div class="demo-badge">Maquette premium · données de démonstration</div>

<script>{% verbatim %}
const PRO=[
 {dom:'Expertise comptable',pros:[{n:'Cabinet Durand & Associés',r:'Expert-comptable · CAC',dispo:'Sous 48h',init:'DA'},{n:'Cabinet Novéo Audit',r:'Expert-comptable',dispo:'Sous 4j',init:'NA'}]},
 {dom:'Droit des affaires',pros:[{n:'Me Sophie Lambert',r:'Avocate — droit des sociétés',dispo:'Sous 72h',init:'SL'},{n:'Me Karim Benali',r:'Avocat — contrats & contentieux',dispo:'Sous 5j',init:'KB'}]},
 {dom:'Fiscalité',pros:[{n:'Cabinet FiscaConseil',r:'Fiscaliste',dispo:'Sous 5j',init:'FC'}]},
 {dom:'Paie & social',pros:[{n:'PaieExpert Services',r:'Gestionnaire paie / DSN',dispo:'Sous 48h',init:'PE'}]},
 {dom:'Financement & DAF externe',pros:[{n:'Hélène Roux',r:'DAF externalisée à temps partagé',dispo:'Sous 1 sem.',init:'HR'}]}
];
const SLOTS=['Mar. 11 · 09:00','Mar. 11 · 14:30','Mer. 12 · 10:00','Jeu. 13 · 16:00','Ven. 14 · 11:30','Ven. 14 · 15:00'];
const pros=document.getElementById('pros'),rdv=document.getElementById('rdv');
pros.innerHTML=PRO.map((d,i)=>`
 <div class="dom">
   <button class="tree-row" data-i="${i}"><span class="tree-caret">▶</span><span class="fl">${d.dom}</span><span class="badge navy">${d.pros.length} pro${d.pros.length>1?'s':''}</span></button>
   <div class="dom-body" data-body="${i}">
     ${d.pros.map(p=>`<div class="pro-row"><div class="avatar">${p.init}</div><div style="flex:1"><div class="pn">${p.n}</div><div class="pr">${p.r}</div></div><span class="badge green">${p.dispo}</span><button class="btn-rdv" data-n="${p.n}">Rendez-vous</button></div>`).join('')}
   </div>
 </div>`).join('');
function setOpen(b,open){b.style.maxHeight=open?(b.scrollHeight+'px'):'0';}
pros.querySelectorAll('.tree-row').forEach(r=>{const i=r.dataset.i,body=pros.querySelector(`[data-body="${i}"]`),caret=r.querySelector('.tree-caret');
 r.addEventListener('click',()=>{const open=!caret.classList.contains('open');caret.classList.toggle('open',open);setOpen(body,open);});});
let selSlot=null,selPro=null;
function pick(name){selPro=name;selSlot=null;
 rdv.innerHTML=`<div style="font-size:13px;color:var(--slate);margin-bottom:6px">Professionnel : <b style="color:var(--ink)">${name}</b></div>
   <div class="dh">Créneaux disponibles</div>
   <div class="slots">${SLOTS.map((s,k)=>`<div class="slot" data-k="${k}">${s}</div>`).join('')}</div>
   <div style="margin-top:14px;display:flex;gap:8px"><button class="btn-rdv" id="confirm" disabled style="opacity:.5">Confirmer le rendez-vous</button><button class="slot" id="change" style="padding:8px 12px">Changer</button></div>
   <div id="ok" style="margin-top:10px;font-size:12px;color:var(--green);display:none">✓ Le copilote joindra le dossier BÉTA (partage limité à 7 jours, révocable).</div>`;
 rdv.querySelectorAll('.slot[data-k]').forEach(s=>s.addEventListener('click',()=>{selSlot=+s.dataset.k;rdv.querySelectorAll('.slot[data-k]').forEach(x=>x.classList.remove('sel'));s.classList.add('sel');const c=document.getElementById('confirm');c.disabled=false;c.style.opacity=1;document.getElementById('ok').style.display='block';}));
 document.getElementById('change').addEventListener('click',()=>{rdv.innerHTML='<div class="empty"><div style="font-size:14px;color:var(--ink);font-weight:600">Sélectionnez un professionnel</div><div style="font-size:12.5px;color:var(--slate);margin-top:6px">Choisissez un domaine à gauche puis « Rendez-vous ».</div></div>';});
 document.getElementById('confirm').addEventListener('click',()=>{if(selSlot!==null)document.getElementById('ok').innerHTML='✓ Rendez-vous confirmé (démonstration) — salle de décision et partage préparés par le copilote.';});
}
pros.addEventListener('click',e=>{const b=e.target.closest('.btn-rdv');if(b&&b.dataset.n){pick(b.dataset.n);document.getElementById('rdv').scrollIntoView({behavior:'smooth',block:'nearest'});}});
document.getElementById('ctaRdv').addEventListener('click',()=>pick('Me Sophie Lambert'));
const seen=new WeakSet();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting||seen.has(e.target))return;seen.add(e.target);e.target.classList.add('in');}),{threshold:.2});
document.querySelectorAll('.rise').forEach((c,i)=>{c.style.transitionDelay=(Math.min(i,6)*55)+'ms';io.observe(c);});
{% endverbatim %}</script>
</body>
</html>
