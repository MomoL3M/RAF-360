<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;background:#f4f7fc;font-family:Arial,Helvetica,sans-serif;color:#101b3a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f7fc;padding:24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border:1px solid #dce4f2;border-radius:14px;overflow:hidden;">
                    <tr>
                        <td style="background:#14306b;padding:20px 28px;">
                            <span style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.02em;">RAF<span style="color:#eda323;">360</span></span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:28px;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:18px 28px;background:#f7f9fd;border-top:1px solid #dce4f2;color:#64708f;font-size:12px;line-height:1.6;">
                            RAF360 — édité par Lindbergh Formation SAS · 16 rue de Maillé, 91310 Montlhéry, France<br>
                            <a href="{{ url('accueil') }}" style="color:#14306b;">raf360.fr</a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
