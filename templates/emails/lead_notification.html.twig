{% extends 'emails/_base.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 18px;font-size:19px;color:#14306b;">{{ subject }}</h1>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.6;">
        {% for label, value in fields %}
            <tr>
                <td style="padding:6px 12px 6px 0;color:#64708f;font-weight:700;vertical-align:top;white-space:nowrap;">{{ label }}</td>
                <td style="padding:6px 0;color:#101b3a;">{{ value|nl2br }}</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
